# ============================================
# application.properties.example
# 复制此文件为 application.properties 并填入实际值
# 或设置对应的环境变量
# ============================================

# NapCat WebSocket 配置
NAPCT_WS_URL=ws://127.0.0.1:5701/?access_token=your_token
NAPCT_WS_BASE_URL=ws://127.0.0.1:5700
ONEBOT_HTTP_BASE_URL=http://127.0.0.1:5700
ONEBOT_ACCESS_TOKEN=your_access_token

# AI 服务配置 (OpenAI 兼容 API)
BAILIAN_API_KEY=sk-your-key
# 官方 DeepSeek Flash 独立密钥；真实值只注入运行环境，不要写入仓库
DEEPSEEK_FLASH_API_KEY=sk-your-key
BAILIAN_BASE_URL=https://api.deepseek.com/v1/chat/completions
# openai（默认）或 anthropic；Anthropic 可填服务的 /v1 根地址，程序会请求 /v1/messages
BAILIAN_PROTOCOL=openai
BAILIAN_CHAT_MODEL=deepseek-v4-pro
# 默认只用独立 Vision 描述图片；确认主模型兼容 image_url 后再设为 true，主聊天才会同时收到本轮原图
BAILIAN_MULTIMODAL_ENABLED=false
BAILIAN_TIMEOUT_MS=90000
BAILIAN_MAX_RETRIES=2

# 主模型候选池（可选）：启动探测一次；当前线路变慢/失败时并发短探测，后续新请求使用最快成功线路
# 格式：id|base_url|model|protocol|api_key_env，多条线路用分号分隔；最后一列只能写环境变量名
# 运行时增删：将完整候选串写入运行时配置 main_model_pool_candidates；下一次请求热重载，留空回退本配置
# PROBE_INTERVAL_MS 现表示两次非强制探测之间的最短冷却时间
# 启用前请把 Gemini 所用 YeToken 密钥注入 YETOKEN_API_KEY，把 Claude 测试密钥注入 YETOKEN_CLAUDE_API_KEY，
# 再把两把 WYY22 密钥分别注入 WYY22_API_KEY_1/2
BAILIAN_POOL_ENABLED=false
BAILIAN_POOL_PROBE_INTERVAL_MS=600000
BAILIAN_POOL_PROBE_TIMEOUT_MS=15000
BAILIAN_POOL_CANDIDATES=claude-opus-4-6-yetoken|https://yetoken.vip/v1|claude-opus-4-6|anthropic|YETOKEN_CLAUDE_API_KEY;claude-haiku-4-5-20251001-yetoken|https://yetoken.vip/v1|claude-haiku-4-5-20251001|anthropic|YETOKEN_CLAUDE_API_KEY;claude-opus-4-7-yetoken|https://yetoken.vip/v1|claude-opus-4-7|anthropic|YETOKEN_CLAUDE_API_KEY;claude-fable-5-yetoken|https://yetoken.vip/v1|claude-fable-5|anthropic|YETOKEN_CLAUDE_API_KEY;claude-opus-5-yetoken|https://yetoken.vip/v1|claude-opus-5|anthropic|YETOKEN_CLAUDE_API_KEY;gemini-3.1-flash-lite|https://yetoken.vip/v1|gemini-3.1-flash-lite|anthropic|YETOKEN_API_KEY;gemini-3-flash|https://yetoken.vip/v1|gemini-3-flash|anthropic|YETOKEN_API_KEY;gemini-2.5-flash-lite|https://yetoken.vip/v1|gemini-2.5-flash-lite|anthropic|YETOKEN_API_KEY;gpt-5.6-luna-wyy-1|https://www.wyy22.com/v1|gpt-5.6-luna|openai|WYY22_API_KEY_1;gpt-5.6-luna-wyy-2|https://www.wyy22.com/v1|gpt-5.6-luna|openai|WYY22_API_KEY_2;deepseek-flash-official|https://api.deepseek.com/v1|deepseek-flash|openai|DEEPSEEK_FLASH_API_KEY|thinking=disabled

# Agnes 免费 Flash 生图/生视频（需要明确设置 AGNES_ENABLED=true）
# 密钥只通过 AGNES_API_KEY 注入；默认 API 地址与 agnes-free-media skill 一致
AGNES_ENABLED=false
AGNES_API_KEY=your-agnes-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_VIDEO_RETRIEVE_URL=https://api.agnes-ai.cn/agnesapi
AGNES_PRICING_URL=https://wiki.agnes-ai.com/en/docs/pricing.md
AGNES_OUTPUT_DIR=/opt/qq-bot/generated-media
AGNES_REQUEST_TIMEOUT_MS=120000
AGNES_VIDEO_TIMEOUT_MS=1800000
AGNES_POLL_INTERVAL_MS=2000
AGNES_VERIFY_FREE_PRICING=true

# Agent 服务配置
AGENT_API_KEY=sk-your-key
AGENT_BASE_URL=https://api.deepseek.com/v1/chat/completions
AGENT_MODEL=deepseek-v4-pro
AGENT_TIMEOUT_MS=90000
AGENT_MAX_RETRIES=2

# 审计/日志总结服务（OpenAI 兼容 API）
AUDIT_API_KEY=sk-your-key
AUDIT_BASE_URL=https://ai.furry.vg/v1/chat/completions
AUDIT_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
AUDIT_TIMEOUT_MS=120000

# 兼容旧版
DASHSCOPE_API_KEY=sk-your-key

# 目标群号
TARGET_GROUP_ID=0

# 调试模式
DEBUG=false

# Web Dashboard / 表情包审阅面板
# 仅本机访问可使用 127.0.0.1；对外监听时必须配置 Token
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_TOKEN=replace-with-a-long-random-token

# 私聊白名单
PRIVATE_WHITELIST_ENABLED=false

# 机器人 QQ 号
BOT_QQ=0

# 管理员 QQ 号
ADMIN_QQ=3524398813

# 允许的群号（逗号分隔）
ALLOWED_GROUPS=

# 预加载的群号（逗号分隔）
PRELOAD_GROUPS=

# 允许私聊的用户（逗号分隔）
ALLOWED_PRIVATE_USERS=

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/candybear_db
DB_USER=candybear
DB_PASSWORD=your_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
